# Database connection URI (default: SQLite)
DATABASE_URL=sqlite:///./butterfly_effect.db

# JWT Security
JWT_SECRET=butterfly-effect-super-secret-key-change-in-production-2026
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# AI Provider Configuration ('mock' for zero-downtime offline mode, or 'openai')
AI_PROVIDER=mock
AI_API_KEY=
AI_MODEL=gpt-4o-mini

# Simulation Resource Bounds (OWASP DoS Protection)
MAX_SIMULATION_STEPS=100000
MAX_SIMULATION_DURATION=100.0
MIN_SIMULATION_DT=0.0001
MAX_SIMULATION_DT=0.5
MAX_HEATMAP_GRID_SIZE=35
MAX_MICROSCOPE_LEVELS=10
